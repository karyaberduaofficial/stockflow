      "activeBg": "#1B4332",
      "activeBorder": "#E87A4A",
      "accentPine": "#86BD7C",
      "accentTerracotta": "#E87A4A",
      "accentOchre": "#EAB34B"
    },
    "semantic": {
      "success": {
        "base": "#15803D",
        "bg": "#E8F7EE",
        "text": "#14532D",
        "border": "#A7DEC0"
