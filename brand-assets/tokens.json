    "chartSeries": [
      { "index": 1, "name": "Deep Forest Pine", "hex": "#1B4332", "role": "Revenue / Stock Value / Assets" },
      { "index": 2, "name": "Warm Terracotta", "hex": "#C2592B", "role": "COGS / Outbound / Procurement" },
      { "index": 3, "name": "Harvest Ochre", "hex": "#B47B1B", "role": "Gross Margin / PPN & PPh Tax" },
      { "index": 4, "name": "Olive-Sage", "hex": "#4D7C0F", "role": "In-Transit / Warehouse Transfer" },
      { "index": 5, "name": "Deep Burgundy", "hex": "#7F1D4A", "role": "OpEx / Payroll / Liabilities" },
      { "index": 6, "name": "Warm Stone", "hex": "#57534E", "role": "Prior Period / Benchmark" }
    ]
  },
  "typography": {
    "fontFamily": {
      "display": "'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif",
      "sans": "'Inter', system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scalePx": {
      "display": 32,
      "h1": 28,
      "h2": 22,
      "h3": 18,
      "h4": 16,
      "body": 14,
      "table": 13,
      "caption": 12,
      "micro": 11
    },
    "fluid": {
      "display": "clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem)",
      "h1": "clamp(1.5rem, 1.25rem + 0.9vw, 1.875rem)",
      "h2": "clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem)",
      "h3": "clamp(1.0625rem, 1rem + 0.25vw, 1.25rem)"
    },
    "lineHeight": {
      "tight": 1.2,
      "heading": 1.3,
      "body": 1.55,
      "relaxed": 1.65
    },
    "readingMaxCh": 72,
    "tabularNumsMandatory": true
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "sidebarWidth": "256px",
    "sidebarCollapsedWidth": "72px",
    "topbarHeight": "64px"
  },
  "radius": {
    "xs": "4px",
    "control": "6px",
    "card": "8px",
    "modal": "12px",
    "pill": "9999px"
  },
  "elevation": {
    "xs": "0 1px 2px rgba(28, 25, 23, 0.05)",
    "sm": "0 2px 6px -1px rgba(28, 25, 23, 0.07), 0 1px 3px rgba(28, 25, 23, 0.04)",
    "md": "0 8px 20px -6px rgba(28, 25, 23, 0.11), 0 2px 6px -2px rgba(28, 25, 23, 0.05)",
    "lg": "0 16px 36px -10px rgba(28, 25, 23, 0.16), 0 4px 12px -4px rgba(28, 25, 23, 0.06)"
  },
  "backgroundAndMotion": {
    "presetName": "craft-executive-mesh-grid",
    "heroMeshLight": "radial-gradient(circle at 12% 14%, rgba(27, 67, 50, 0.08) 0%, transparent 48%), radial-gradient(circle at 86% 10%, rgba(194, 89, 43, 0.07) 0%, transparent 44%), radial-gradient(circle at 52% 95%, rgba(180, 123, 27, 0.05) 0%, transparent 50%), linear-gradient(180deg, #FFFFFF 0%, #FAF8F5 100%)",
    "heroMeshDark": "radial-gradient(circle at 12% 14%, rgba(134, 189, 124, 0.10) 0%, transparent 48%), radial-gradient(circle at 86% 10%, rgba(232, 122, 74, 0.10) 0%, transparent 44%), linear-gradient(180deg, #292524 0%, #1C1917 100%)",
    "surfacePatternLight": "linear-gradient(to right, rgba(28, 25, 23, 0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(28, 25, 23, 0.04) 1px, transparent 1px)",
    "surfacePatternDark": "linear-gradient(to right, rgba(250, 248, 245, 0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(250, 248, 245, 0.04) 1px, transparent 1px)",
    "surfacePatternSize": "24px 24px",
    "glassSurfaceLight": "rgba(250, 248, 245, 0.88)",
    "glassBorderLight": "rgba(229, 222, 213, 0.92)",
    "glassSurfaceDark": "rgba(28, 25, 23, 0.86)",
    "glassBorderDark": "rgba(63, 58, 54, 0.90)",
    "motion": {
      "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
      "durationFastMs": 120,
      "durationBaseMs": 160,
      "durationDrawerMs": 220,
      "durationRevealMs": 320,
      "staggerStepMs": 45,
      "cardHoverTransform": "translateY(-2px)"
    }
  },
  "interaction": {
    "minTouchTargetPx": 44,
    "minControlGapPx": 8,
    "focusOutlineWidthPx": 3,
    "focusOutlineOffsetPx": 2,
    "states": [
      "default",
      "hover",
      "focus-visible",
      "active",
      "disabled",
      "loading-skeleton",
      "empty",
      "error-success"
    ]
  },
