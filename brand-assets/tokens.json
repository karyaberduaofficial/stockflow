{
  "$schema": "https://stockflow.karyaberdua.id/schemas/design-tokens.v1.json",
  "meta": {
    "brand": "StockFlow",
    "organization": "Karya Berdua",
    "domain": "Household Furniture & Homeware Retail ERP (Inventory, Warehouse, Sales, Accounting, Tax & HR Payroll)",
    "version": "1.0.0",
    "tier": "corporate",
    "segment": "perusahaan",
    "topics": ["finance-commerce", "fintech-erp", "ecommerce-umkm"],
    "zeroBluePolicy": true,
    "wcagCompliance": {
      "standard": "WCAG 2.2 Level AA (AAA on primary typography and dark sidebar)",
      "minimumBodyContrast": 4.5,
      "minimumUiFocusContrast": 3.0,
      "verifiedBy": "ui-ux-multi-segmen/lib/tokens-engine.mjs"
    }
  },
